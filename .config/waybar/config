{
    "layer": "top",
    "position": "top",
	"height": 30,
	"margin": 0,
	
	"modules-left": [
		"hyprland/workspaces",
		"cpu",
		"memory",
		"temperature"
	],
	"modules-right": [
		"pulseaudio",
		//"bluetooth",
		//"backlight",
		//"battery",
		"clock",
		"custom/power"
	],

	"pulseaudio": {
        "format": "VOL: {volume}%",
		"format-bluetooth": "{volume}% {icon}",
        	"format-bluetooth-muted": " {icon}",
        	"format-source-muted": "",
        	"format-icons": {
            		"headphone": "",
            		"hands-free": "",
            		"headset": "",
            		"phone": "",
            		"portable": "",
            		"car": "",
            		"default": ["", "", ""]
		},
        "on-click": ""
    },

    	"hyprland/workspaces": {
		"disable-scroll": true,
		"format": "{icon}{name}",
		"format-icons": {
			"default": "",
			"urgent": "!",
			"active": "*"
		},
	},

	"cpu": {
        "format": "CPU: {usage}%",
    	"tooltip": false
	},
    
	"memory": {
    	"format": "MEM: {}%"
	},

	"temperature": {
     	"thermal-zone": 2,
        "hwmon-path": "/sys/devices/virtual/thermal/thermal_zone2/temp",
		"critical-threshold": 80,
    	"format": "TEMP: {temperatureC}°C"
    },

